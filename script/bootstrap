#!/bin/bash

export SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

##
## Configuration Variables
##

config() {
  # A whitespace-separated list of executables that must be present and locatable.
  # These will each be installed through Homebrew if not found.
  : ${REQUIRED_TOOLS="cmake libssh2 libtool autoconf automake pkg-config openssl"}

  export REQUIRED_TOOLS
}

##
## Bootstrap Process
##

main() {
  config

  git submodule update --init --recursive

  if [ -n "$REQUIRED_TOOLS" ]; then
    echo "** Checking dependencies in Homebrew ..."
    if [ -n "$UNIVERSAL_BUILD" ]; then
      check_deps_universal
    else
      check_deps
    fi
  fi
}

check_deps() {
  # Check if Homebrew is installed
  which -s brew
  local result=$?

  if [ "$result" -ne "0" ]; then
    echo
    echo "Homebrew is not installed (http://brew.sh). You will need to manually ensure the following tools are installed:"
    echo "  $REQUIRED_TOOLS"
    echo
    echo "Additionally, the following libssh2 files must be symlinked under /usr/local or /opt/homebrew :"
    echo "  lib/libssh2.a include/libssh2.h include/libssh2_sftp.h include/libssh2_publickey.h"

    if [ ! -z "$CI" ]; then
      echo
      echo "I will try to install it now on github CI"
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >>/Users/hannes/.zprofile
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
  fi

  brew_prefix=$(brew --prefix)
  if [[ $(uname -m) == 'arm64' ]]; then
    echo "** Running on a Apple Silicon M1"
    export expected_prefix=/opt/homebrew
  else
    echo "** Running on a Apple x86"
    export expected_prefix=/usr/local
  fi

  install_tools "$brew_prefix"
  stage_deps "$brew_prefix" "./External"

  if [ "$brew_prefix" != "$expected_prefix" ]; then
    echo "*** Adding soft links into $expected_prefix..."

    products=(lib/libssh2.a include/libssh2.h include/libssh2_sftp.h include/libssh2_publickey.h)

    for product in "${products[@]}"; do
      destination="$expected_prefix/$product"
      if [ -e "$destination" ]; then
        continue
      fi

      sudo mkdir -p "$(dirname "$destination")"
      sudo ln -s "$brew_prefix/$product" "$destination"
    done
  fi
}

# Builds a universal libcrypto.a/libssh2.a by lipo-ing together the arm64
# Homebrew install at /opt/homebrew with an x86_64 (Rosetta) Homebrew install
# at /usr/local. Both installs, and the tools under each, are expected to
# already exist -- setting them up is the CI workflow's job, not this
# script's, since it means bootstrapping a second Homebrew prefix.
check_deps_universal() {
  local arm64_prefix=/opt/homebrew
  local x86_64_prefix=/usr/local

  for prefix in "$arm64_prefix" "$x86_64_prefix"; do
    if [ ! -x "$prefix/bin/brew" ]; then
      echo "UNIVERSAL_BUILD requires a Homebrew install at $prefix; none found." >&2
      exit 1
    fi
  done

  install_tools "$arm64_prefix"
  install_tools "$x86_64_prefix" arch -x86_64

  local staging="./External/universal-deps"
  rm -rf "$staging"
  mkdir -p "$staging/arm64" "$staging/x86_64"

  stage_deps "$arm64_prefix" "$staging/arm64"
  stage_deps "$x86_64_prefix" "$staging/x86_64"

  echo "*** Combining arm64 + x86_64 libssh2.a and libcrypto.a into universal libraries"
  for lib in libssh2.a libcrypto.a; do
    lipo -create \
      "$staging/arm64/$lib" \
      "$staging/x86_64/$lib" \
      -output "./External/$lib"
  done

  rm -rf "$staging"
  ls -la ./External
}

# install_tools <brew_prefix> [command prefix to run brew under, e.g. `arch -x86_64`]
install_tools() {
  local prefix="$1"
  shift
  local run=("$@" "$prefix/bin/brew")

  local installed
  installed=$("${run[@]}" list)

  for tool in $REQUIRED_TOOLS; do
    echo "$installed" | grep -q "$tool" && code=$? || code=$?

    if [ "$code" -eq "0" ]; then
      echo "*** $tool is available under $prefix 👍"
      continue
    elif [ "$code" -ne "1" ]; then
      exit $code
    fi

    echo "*** Installing $tool under $prefix with Homebrew..."
    "${run[@]}" install "$tool"
  done
}

# stage_deps <brew_prefix> <destination dir> - copies that prefix's
# libssh2.a/libcrypto.a into destination, for either direct use (single-arch)
# or as lipo input (universal).
stage_deps() {
  local prefix="$1"
  local destination="$2"

  echo "*** copy $prefix/lib/libssh2.a to $destination"
  cp "$prefix/lib/libssh2.a" "$destination"

  # openssl@1 is expected
  local sslSource
  sslSource=$(find "$prefix" -name libcrypto.a | grep openssl | sort | head -1 | xargs dirname)
  echo "Find libcrypto.a and take first $sslSource and copy to $destination"
  cp $sslSource/* "$destination" 2>/dev/null | echo "Copy and ignore subdirectory. This makes build work on x86 and arm64"
}

main
